# ============================================================
#  Variables del stack de DESPLIEGUE
#
#  Este archivo (.env.example) SI va al repo, con valores falsos.
#  El .env real NUNCA va al repo: vive en ~/labgarcias-secrets/.env
# ============================================================

# ---- Puertos en tu PC -----------------------------------------------
# La app queda en http://localhost:8090
# Cambialo si 8090 esta ocupado (verificar con: sudo ss -tulpn | grep 8090)
APP_PORT=8090

# Postgres del despliegue. Tu Postgres de desarrollo sigue en 5436.
DB_PORT_HOST=5437

# ---- Base de datos ---------------------------------------------------
DB_NAME=labgarcias_db
DB_USERNAME=labgarcias_user
DB_PASSWORD=CAMBIAME_password_larga_y_distinta_a_la_de_dev

# ---- Seguridad -------------------------------------------------------
# Generar con:  openssl rand -base64 48
JWT_SECRET=CAMBIAME_generar_con_openssl_rand_base64_48
JWT_EXPIRACION_MINUTOS=480

# ---- Aplicacion ------------------------------------------------------
LAB_ZONA_HORARIA=America/Montevideo
CORS_ALLOWED_ORIGINS=http://localhost:8090

# ---- Correo ----------------------------------------------------------
# Con estos valores por defecto el envio queda FALLIDO y la notificacion
# se sigue viendo en la campana. La app arranca igual.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_REMITENTE=no-responder@labgarcias.local

# ---- Telegram --------------------------------------------------------
# Vacio = canal deshabilitado, la app arranca igual.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLLING_MS=5000

# ---- JVM -------------------------------------------------------------
JAVA_OPTS=-Xms256m -Xmx768m
