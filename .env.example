# Copiar como .env (o exportar como variables de entorno) y completar con valores reales.
# .env está en .gitignore: nunca versionar credenciales reales.

DB_HOST=localhost
DB_PORT=5436
DB_USERNAME=changeme
DB_PASSWORD=changeme

# JWT_SECRET: clave HMAC para firmar el JWT (HS256 exige al menos 32 caracteres).
# Generar una propia por instalación, ej.: openssl rand -base64 48
JWT_SECRET=changeme-clave-secreta-de-al-menos-32-caracteres

# ALMACENAMIENTO_DIRECTORIO: carpeta donde se guardan los adjuntos de las órdenes
# (RN-13). Relativa al directorio desde el que arranca el backend, o absoluta.
# En producción, ruta absoluta y fuera del directorio de la aplicación.
ALMACENAMIENTO_DIRECTORIO=./archivos

# CORS_ALLOWED_ORIGINS: orígenes del frontend, separados por coma. En producción, solo el
# dominio del laboratorio. Obligatoria con el perfil prod.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMTP (§6.3). En desarrollo alcanza con un servidor local tipo MailHog en el 1025 y sin
# autenticación. Con el perfil prod, MAIL_HOST, MAIL_USERNAME, MAIL_PASSWORD y MAIL_REMITENTE
# son obligatorias: sin ellas la aplicación no arranca.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
# MAIL_REMITENTE: dirección desde la que salen los avisos y el correo de credenciales (§3.1.b).
MAIL_REMITENTE=no-responder@labgarcias.local

# TELEGRAM_BOT_TOKEN (§6.3, §6.5, P-20): token del bot, creado con @BotFather. Es un secreto:
# nunca versionarlo ni pegarlo en el código. Si se deja vacío, el canal Telegram se deshabilita
# solo —la aplicación arranca igual— y sus envíos quedan FALLIDO con el motivo a la vista.
TELEGRAM_BOT_TOKEN=
